{
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(npx @marp-team/marp-cli *)",
      "Bash(mkdir -p *)",
      "Bash(find . *)",
      "Bash(ls *)",
      "Bash(cat *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == *.py ]] && .venv/bin/ruff format --quiet \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null && .venv/bin/ruff check --fix --quiet \"$CLAUDE_TOOL_INPUT_FILE_PATH\" 2>/dev/null; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/bin/python hooks/on_stop.py 2>/dev/null; exit 0"
          }
        ]
      }
    ]
  }
}
